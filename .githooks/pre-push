#!/usr/bin/env bash
# Pre-push gate: the full test suite must pass before anything is pushed. Install with: make install-hooks. (Do not bypass with --no-verify.)
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: running the full test suite (about 2.5 minutes)..."
set -a; [ -f .env ] && . ./.env; set +a
if bash scripts/run_tests_safely.sh; then echo "pre-push: tests passed, pushing"; else echo "pre-push: TESTS FAILED, push blocked"; exit 1; fi
